<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <style>
        :root {
            --bg: #f4efe6;
            --panel: #fffdf8;
            --ink: #1f2937;
            --muted: #6b7280;
            --accent: #ff4500;
            --accent-soft: #fff1ee;
            --border: #e5dccf;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Trebuchet MS", Verdana, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        main {
            max-width: 1150px;
            margin: 0 auto;
            padding: 40px 20px 60px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        h1,
        h2 {
            margin: 0;
        }

        a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }

        .notice,
        .error {
            margin-bottom: 16px;
            padding: 14px 16px;
            border-radius: 14px;
        }

        .notice {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fef2f2;
            color: #991b1b;
        }

        .layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 20px;
        }

        .panel {
            background: var(--panel);
            border-radius: 18px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 50px rgba(31, 41, 55, 0.08);
            padding: 22px;
        }

        .form-grid {
            display: grid;
            gap: 12px;
            margin-top: 16px;
        }

        label {
            display: grid;
            gap: 6px;
            font-weight: 700;
        }

        input {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font: inherit;
            background: #fdf8f0;
        }

        input:focus {
            outline: none;
            border-color: var(--accent);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--panel);
            border-radius: 18px;
            overflow: hidden;
        }

        th,
        td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        th {
            background: var(--accent-soft);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--accent);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #fdf8f2;
        }

        .pill {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: 0.82rem;
            font-weight: 700;
        }

        .muted {
            color: var(--muted);
            font-size: 0.88rem;
        }

        button {
            border: 0;
            border-radius: 12px;
            padding: 11px 14px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .primary {
            background: var(--accent);
            color: white;
            width: 100%;
        }

        .primary:hover {
            background: #e03d00;
        }

        .empty {
            padding: 32px;
            text-align: center;
            color: var(--muted);
        }

        @media (max-width: 860px) {
            .layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <main>
        <header>
            <div>
                <a href="/"> &lt;- Back to dashboard</a>
                <h1 style="margin-top:6px;">Clients</h1>
            </div>
            <p class="muted">All registered users in the system.</p>
        </header>

        <% if (message) { %>
            <div class="<%= messageType === 'error' ? 'error' : 'notice' %>"> <%= message %> </div>
        <% } %>
        
        <% if (error) { %>
            <div class="error"> <%= error %> </div>
        <% } %>

        <div class="layout">
            <!-- Create form -->
            <aside class="panel">
                <h2>Create Client</h2>
                <p class="muted" style="margin-top:8px;">Add a new client to the system.</p>
                <form class="form-grid" method="post" action="/clients">
                    <label>
                        Username
                        <input type="text" name="username" placeholder="Client name" required />
                    </label>
                    <label>
                        Email
                        <input type="email" name="email" placeholder="client@example.com" required />
                    </label>
                    <label>
                        Password
                        <input type="password" name="password" placeholder="Min. 6 characters" required />
                    </label>
                    <button class="primary" type="submit">Create Client</button>
                </form>
            </aside>

            <!-- Clients table -->
            <section>
                <% if (!clients || !clients.length) { %>
                    <div class="panel">
                    <div class="empty">No clients yet. Create the first one!</div>
                    </div>
                <% } else { %>
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% clients.forEach(client=> { %>
                                <tr>
                                    <td><span class="pill">#<%= client.id %></span></td>
                                    <td>
                                        <strong><%= client.username %></strong>
                                    </td>
                                    <td class="muted">
                                        <%= client.email %>
                                    </td>
                                    <td class="muted">
                                        <%= new Date(client.createdAt).toLocaleDateString('en-US', {
                                            year:'numeric', month:'short', day:'numeric' }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        </div>
    </main>
</body>

</html> 