<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <style>
        :root {
            --bg: #f4efe6;
            --panel: #fffdf8;
            --ink: #1f2937;
            --muted: #6b7280;
            --accent: #ff4500;
            --accent-soft: #fff1ee;
            --border: #e5dccf;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Trebuchet MS", Verdana, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        main {
            max-width: 1150px;
            margin: 0 auto;
            padding: 40px 20px 60px;
        }

        h1,
        h2 {
            margin: 0;
        }

        a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }

        .notice,
        .error {
            margin-bottom: 16px;
            padding: 14px 16px;
            border-radius: 14px;
        }

        .notice {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fef2f2;
            color: #991b1b;
        }

        .post-card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 22px 24px;
            margin-bottom: 24px;
        }

        .post-title {
            font-size: 1.4rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .post-content {
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 12px;
        }

        .post-meta {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 0.85rem;
            color: var(--muted);
            align-items: center;
        }

        .tag {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            font-weight: 700;
            font-size: 0.8rem;
        }

        .post-votes {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 14px;
        }

        .btn-vote {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: #fdf8f0;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .btn-vote:hover {
            background: var(--accent-soft);
            border-color: var(--accent);
        }

        .vote-score {
            font-weight: 800;
            font-size: 1rem;
        }

        .layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 20px;
        }

        .panel {
            background: var(--panel);
            border-radius: 18px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 50px rgba(31, 41, 55, 0.08);
            padding: 22px;
        }

        .form-grid {
            display: grid;
            gap: 12px;
            margin-top: 16px;
        }

        label {
            display: grid;
            gap: 6px;
            font-weight: 700;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font: inherit;
            background: #fdf8f0;
            resize: vertical;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--accent);
        }

        button {
            border: 0;
            border-radius: 12px;
            padding: 11px 14px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .primary {
            background: var(--accent);
            color: white;
            width: 100%;
        }

        .primary:hover {
            background: #e03d00;
        }

        .hint {
            color: var(--muted);
            font-weight: 400;
            font-size: 0.8rem;
        }

        .comments-header {
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 14px;
        }

        .comment-list {
            display: grid;
            gap: 12px;
        }

        .comment-card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px 18px;
            display: grid;
            grid-template-columns: 42px 1fr;
            gap: 12px;
        }

        .comment-card.reply {
            margin-left: 28px;
            border-left: 3px solid #ffb99e;
        }

        .c-vote-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding-top: 2px;
        }

        .btn-c-vote {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: #fdf8f0;
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .btn-c-vote:hover {
            background: var(--accent-soft);
            border-color: var(--accent);
        }

        .c-vote-count {
            font-weight: 800;
            font-size: 0.82rem;
        }

        .c-header {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-bottom: 6px;
            flex-wrap: wrap;
        }

        .c-author {
            font-weight: 700;
            font-size: 0.9rem;
        }

        .c-id {
            font-size: 0.78rem;
            color: var(--muted);
            background: var(--bg);
            padding: 2px 8px;
            border-radius: 999px;
            font-weight: 700;
        }

        .c-reply-tag {
            font-size: 0.78rem;
            color: var(--accent);
            background: var(--accent-soft);
            padding: 2px 8px;
            border-radius: 999px;
            font-weight: 700;
        }

        .c-date {
            font-size: 0.78rem;
            color: var(--muted);
        }

        .c-content {
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .muted {
            color: var(--muted);
            font-size: 0.88rem;
        }

        .empty {
            padding: 32px;
            text-align: center;
            color: var(--muted);
        }

        @media (max-width:860px) {
            .layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <main>
        <div style="margin-bottom:20px;">
            <a href="/posts">&lt;- Back to Posts</a>
        </div>

        <% if (message) { %>
            <div class="<%= messageType === 'error' ? 'error' : 'notice' %>"> <%= message %> </div>
        <% } %>

        <% if (error) { %>
            <div class="error"> <%= error %> </div>
        <% } %>

        <!-- Post card -->
        <% if (post) { %>
            <div class="post-card">
                <div class="post-title"> <%= post.title %> </div>
                <% if (post.content) { %>
                    <div class="post-content"> <%= post.content %> </div>
                <% } %>
                <div class="post-meta">
                    <span class="tag"><%= post.community ? post.community.name : '-' %></span>
                    <span>by <%= post.author ? post.author.username : '-' %></span>
                    <span><%= new Date(post.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %> </span>
                    <span>Post ID: <strong>#<%= post.id %></strong></span>
                    <span>💬 <%= post.commentCount %> comments</span>
                </div>
                <div class="post-votes">
                    <form method="post" action="/posts/<%= post.id %>/upvote">
                        <button class="btn-vote" type="submit" title="Upvote">▲</button>
                    </form>
                    <span class="vote-score"> <%= post.voteCount %> </span>
                    <form method="post" action="/posts/<%= post.id %>/downvote">
                        <button class="btn-vote" type="submit" title="Downvote">▼</button>
                    </form>
                </div>
            </div>
        <% } %>

        <div class="layout">
            <!-- Add comment form -->
            <aside class="panel">
                <h2>Add Comment</h2>
                <p class="muted" style="margin-top:8px;">
                    To reply to a comment, enter its <strong>#ID</strong>
                    shown on each comment below.
                </p>
                <% if (post) { %>
                    <form class="form-grid" method="post" action="/posts/<%= post.id %>/comments">
                        <label>
                            Posted by
                            <select name="clientId" required>
                                <option value="">Select a client</option>
                                <% clients.forEach(c=> { %>
                                    <option value="<%= c.id %>">
                                        <%= c.username %>
                                    </option>
                                <% }) %>
                            </select>
                        </label>
                        <label>
                            Comment
                            <textarea name="content" placeholder="What do you think?" rows="4" required></textarea>
                        </label>
                        <label>
                            Reply to Comment ID
                            <span class="hint">(leave blank for top-level)</span>
                            <input type="number" name="parentCommentId" placeholder="e.g. 5" min="1" />
                        </label>
                        <button class="primary" type="submit">Post Comment</button>
                    </form>
                <% } %>
            </aside>

            <!-- Comments list -->
            <section>
                <div class="comments-header">
                    <%= comments.length %> Comment<%= comments.length !==1 ? 's' : '' %>
                </div>
                <% if (!comments || !comments.length) { %>
                    <div class="panel">
                        <div class="empty">No comments yet. Be the first!</div>
                    </div>
                <% } else { %>
                    <div class="comment-list">
                        <% comments.forEach(comment=> { %>
                            <div class="comment-card <%= comment.parentCommentId ? 'reply' : '' %>">
                                <div class="c-vote-col">
                                    <form method="post" action="/comments/<%= comment.id %>/upvote">
                                        <button class="btn-c-vote" type="submit" title="Upvote">▲</button>
                                    </form>
                                    <span class="c-vote-count">
                                        <%= comment.voteCount %>
                                    </span>
                                    <form method="post" action="/comments/<%= comment.id %>/downvote">
                                        <button class="btn-c-vote" type="submit" title="Downvote">▼</button>
                                    </form>
                                </div>
                                <div>
                                    <div class="c-header">
                                        <span class="c-author">
                                            <%= comment.author ? comment.author.username : '-' %>
                                        </span>
                                        <span class="c-id">#<%= comment.id %></span>
                                        <% if (comment.parentCommentId) { %>
                                            <span class="c-reply-tag">↩ reply to #<%= comment.parentCommentId %></span>
                                        <% } %>
                                        <span class="c-date">
                                            <%= new Date(comment.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
                                        </span>
                                    </div>
                                    <div class="c-content">
                                        <%= comment.content %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
</body>

</html>