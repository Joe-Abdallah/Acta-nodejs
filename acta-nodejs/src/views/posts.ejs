<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <style>
        :root {
            --bg: #f4efe6;
            --panel: #fffdf8;
            --ink: #1f2937;
            --muted: #6b7280;
            --accent: #ff4500;
            --accent-soft: #fff1ee;
            --border: #e5dccf;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Trebuchet MS", Verdana, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        main {
            max-width: 1150px;
            margin: 0 auto;
            padding: 40px 20px 60px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        h1,
        h2 {
            margin: 0;
        }

        a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }

        .notice,
        .error {
            margin-bottom: 16px;
            padding: 14px 16px;
            border-radius: 14px;
        }

        .notice {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fef2f2;
            color: #991b1b;
        }

        .layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 20px;
        }

        .panel {
            background: var(--panel);
            border-radius: 18px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 50px rgba(31, 41, 55, 0.08);
            padding: 22px;
        }

        .form-grid {
            display: grid;
            gap: 12px;
            margin-top: 16px;
        }

        label {
            display: grid;
            gap: 6px;
            font-weight: 700;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font: inherit;
            background: #fdf8f0;
            resize: vertical;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--accent);
        }

        button {
            border: 0;
            border-radius: 12px;
            padding: 11px 14px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .primary {
            background: var(--accent);
            color: white;
            width: 100%;
        }

        .primary:hover {
            background: #e03d00;
        }

        .posts-list {
            display: grid;
            gap: 14px;
        }

        .post-card {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 18px 20px;
            display: grid;
            grid-template-columns: 48px 1fr;
            gap: 14px;
        }

        .vote-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding-top: 2px;
        }

        .btn-vote {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: #fdf8f0;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .btn-vote:hover {
            background: var(--accent-soft);
            border-color: var(--accent);
        }

        .vote-count {
            font-weight: 800;
            font-size: 0.95rem;
            color: var(--ink);
        }

        .post-title {
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 4px;
        }

        .post-id {
            color: var(--muted);
            font-size: 0.78rem;
            font-weight: 400;
            margin-left: 6px;
        }

        .post-content {
            color: var(--muted);
            font-size: 0.88rem;
            margin-bottom: 10px;
            line-height: 1.5;
        }

        .post-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            font-size: 0.82rem;
            color: var(--muted);
        }

        .tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            font-weight: 700;
            font-size: 0.78rem;
        }

        .post-meta a {
            color: var(--accent);
            font-weight: 700;
            text-decoration: none;
            font-size: 0.82rem;
        }

        .post-meta a:hover {
            text-decoration: underline;
        }

        .muted {
            color: var(--muted);
            font-size: 0.88rem;
        }

        .empty {
            padding: 32px;
            text-align: center;
            color: var(--muted);
        }

        @media (max-width:860px) {
            .layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <main>
        <header>
            <div>
                <a href="/">&lt;- Back to dashboard</a>
                <h1 style="margin-top:6px;">Posts</h1>
            </div>
            <p class="muted">All posts across all communities.</p>
        </header>

        <% if (message) { %>
            <div class="<%= messageType === 'error' ? 'error' : 'notice' %>"> <%= message %> </div>
        <% } %>
        
        <% if (error) { %>
            <div class="error"> <%= error %> </div>
        <% } %>

        <div class="layout">
            <!-- Create form -->
            <aside class="panel">
                <h2>Create Post</h2>
                <p class="muted" style="margin-top:8px;">Select the community and author from existing records.</p>
                <form class="form-grid" method="post" action="/posts">
                    <label>
                        Community
                        <select name="communityId" required>
                            <option value="">Select a community</option>
                            <% communities.forEach(c=> { %>
                                <option value="<%= c.id %>"><%= c.name %> </option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Posted by
                        <select name="clientId" required>
                            <option value="">Select a client</option>
                            <% clients.forEach(c=> { %>
                                <option value="<%= c.id %>"> <%= c.username %> </option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Title
                        <input type="text" name="title" placeholder="Post title" required />
                    </label>
                    <label>
                        Content 
                        <span style="color:var(--muted);font-weight:400;">(optional)</span>
                        <textarea name="content" placeholder="What is on your mind?" rows="4"></textarea>
                    </label>
                    <button class="primary" type="submit">Post</button>
                </form>
            </aside>

            <!-- Posts list -->
            <section>
                <% if (!posts || !posts.length) { %>
                    <div class="panel">
                        <div class="empty">No posts yet. Create the first one!</div>
                    </div>
                <% } else { %>
                    <div class="posts-list">
                        <% posts.forEach(post=> { %>
                            <div class="post-card">
                                <!-- Vote buttons -->
                                <div class="vote-col">
                                    <form method="post" action="/posts/<%= post.id %>/upvote">
                                        <button class="btn-vote" type="submit" title="Upvote">▲</button>
                                    </form>
                                    <span class="vote-count">
                                        <%= post.voteCount %>
                                    </span>
                                    <form method="post" action="/posts/<%= post.id %>/downvote">
                                        <button class="btn-vote" type="submit" title="Downvote">▼</button>
                                    </form>
                                </div>
                                <!-- Post content -->
                                <div>
                                    <div class="post-title">
                                        <%= post.title %>
                                        <span class="post-id">#<%= post.id %></span>
                                    </div>
                                    <% if (post.content) { %>
                                        <div class="post-content">
                                            <%= post.content.length> 200 ? post.content.substring(0,200)+'...' : post.content %>
                                        </div>
                                    <% } %>
                                    <div class="post-meta">
                                        <span class="tag"><%= post.community ? post.community.name : '-' %></span>
                                        <span>by <%= post.author ? post.author.username : '-' %></span>
                                        <span> <%= new Date(post.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %> </span>
                                        <a href="/posts/<%= post.id %>/comments">💬 <%= post.commentCount %> comments</a>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>
</body>

</html>