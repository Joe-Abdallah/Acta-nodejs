<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <style>
        :root {
            --bg: #f4efe6;
            --panel: #fffdf8;
            --ink: #1f2937;
            --muted: #6b7280;
            --accent: #ff4500;
            --accent-soft: #fff1ee;
            --border: #e5dccf;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Trebuchet MS", Verdana, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        main {
            max-width: 980px;
            margin: 0 auto;
            padding: 48px 20px 64px;
        }

        .hero {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: 0 18px 50px rgba(31, 41, 55, 0.08);
            padding: 32px;
        }

        .eyebrow {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent);
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        h1 {
            margin: 16px 0 12px;
            font-size: clamp(2rem, 5vw, 3.2rem);
        }

        p {
            line-height: 1.6;
            color: var(--muted);
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 24px;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .button {
            padding: 12px 18px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--accent-soft);
            color: var(--accent);
            font-weight: 700;
            font-size: 0.95rem;
        }

        .button:hover {
            background: #ffddd5;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-top: 24px;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(31, 41, 55, 0.06);
            padding: 24px;
        }

        .panel p {
            margin: 0 0 6px;
            font-size: 0.9rem;
        }

        .metric {
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--accent);
            margin: 0;
        }

        .error {
            margin-top: 16px;
            padding: 14px 16px;
            border-radius: 12px;
            background: #fef2f2;
            color: #991b1b;
        }
    </style>
</head>

<body>
    <main>
        <section class="hero">
            <span class="eyebrow">Acta</span>
            <h1>Dashboard</h1>
            <p>Summary of all data in the Acta database. Use the buttons below to manage content.</p>
            <% if (error) { %>
                <div class="error">
                    <%= error %>
                </div>
                <% } %>
                    <nav>
                        <a class="button" href="/clients">Clients</a>
                        <a class="button" href="/communities">Communities</a>
                        <a class="button" href="/posts">Posts</a>
                    </nav>
        </section>

        <div class="grid">
            <article class="panel">
                <p>Total Clients</p>
                <p class="metric">
                    <%= summary.clients %>
                </p>
            </article>
            <article class="panel">
                <p>Communities</p>
                <p class="metric">
                    <%= summary.communities %>
                </p>
            </article>
            <article class="panel">
                <p>Total Posts</p>
                <p class="metric">
                    <%= summary.posts %>
                </p>
            </article>
            <article class="panel">
                <p>Total Comments</p>
                <p class="metric">
                    <%= summary.comments %>
                </p>
            </article>
        </div>
    </main>
</body>

</html>