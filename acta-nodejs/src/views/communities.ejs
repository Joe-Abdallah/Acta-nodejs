<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <style>
        :root {
            --bg: #f4efe6;
            --panel: #fffdf8;
            --ink: #1f2937;
            --muted: #6b7280;
            --accent: #ff4500;
            --accent-soft: #fff1ee;
            --border: #e5dccf;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Trebuchet MS", Verdana, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }

        main {
            max-width: 1150px;
            margin: 0 auto;
            padding: 40px 20px 60px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        h1,
        h2 {
            margin: 0;
        }

        a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }

        .notice,
        .error {
            margin-bottom: 16px;
            padding: 14px 16px;
            border-radius: 14px;
        }

        .notice {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fef2f2;
            color: #991b1b;
        }

        .layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 20px;
        }

        .panel {
            background: var(--panel);
            border-radius: 18px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 50px rgba(31, 41, 55, 0.08);
            padding: 22px;
        }

        .form-grid {
            display: grid;
            gap: 12px;
            margin-top: 16px;
        }

        label {
            display: grid;
            gap: 6px;
            font-weight: 700;
        }

        input,
        textarea,
        select {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font: inherit;
            background: #fdf8f0;
            resize: vertical;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--accent);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--panel);
            border-radius: 18px;
            overflow: hidden;
        }

        th,
        td {
            text-align: left;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        th {
            background: var(--accent-soft);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--accent);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #fdf8f2;
        }

        .muted {
            color: var(--muted);
            font-size: 0.88rem;
        }

        .desc {
            color: var(--muted);
            font-size: 0.85rem;
            margin-top: 3px;
        }

        button {
            border: 0;
            border-radius: 12px;
            padding: 11px 14px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .primary {
            background: var(--accent);
            color: white;
            width: 100%;
        }

        .primary:hover {
            background: #e03d00;
        }

        .empty {
            padding: 32px;
            text-align: center;
            color: var(--muted);
        }

        .join-form {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .join-form select {
            width: auto;
            flex: 1;
            min-width: 120px;
            padding: 7px 10px;
            font-size: 0.85rem;
        }

        .btn-join {
            padding: 7px 14px;
            border-radius: 10px;
            border: 0;
            background: var(--accent-soft);
            color: var(--accent);
            font: inherit;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-join:hover {
            background: var(--accent);
            color: #fff;
        }

        @media (max-width:860px) {
            .layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <main>
        <header>
            <div>
                <a href="/">&lt;- Back to dashboard</a>
                <h1 style="margin-top:6px;">Communities</h1>
            </div>
            <p class="muted">Browse all communities, create your own, or join one.</p>
        </header>

        <% if (message) { %>
            <div class="<%= messageType === 'error' ? 'error' : 'notice' %>"> <%= message %> </div>
        <% } %>
        
        <% if (error) { %>
            <div class="error"> <%= error %> </div>
        <% } %>

        <div class="layout">
            <!-- Create form -->
            <aside class="panel">
                <h2>Create Community</h2>
                <p class="muted" style="margin-top:8px;">Pick a creator from existing clients.</p>
                <form class="form-grid" method="post" action="/communities">
                    <label>
                        Name
                        <input type="text" name="name" placeholder="e.g. programming" required />
                    </label>
                    <label>
                        Description
                        <textarea name="description" placeholder="What is this community about?" rows="3"></textarea>
                    </label>
                    <label>
                        Created by
                        <select name="creatorId" required>
                            <option value="">Select a client</option>
                            <% clients.forEach(c=> { %>
                                <option value="<%= c.id %>">#<%= c.id %> — <%= c.username %> </option>
                            <% }) %>
                        </select>
                    </label>
                    <button class="primary" type="submit">Create Community</button>
                </form>
            </aside>

            <!-- Communities table -->
            <section>
                <% if (!communities || !communities.length) { %>
                    <div class="panel">
                        <div class="empty">No communities yet. Create the first one!</div>
                    </div>
                <% } else { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Members</th>
                                <th>Created</th>
                                <th>Join</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% communities.forEach(c=> { %>
                                <tr>
                                    <td>
                                        <strong><%= c.name %></strong><br />
                                        <span class="muted">by <%= c.creator ? c.creator.username : '—' %></span>
                                    </td>
                                    <td>
                                        <% if (c.description) { %>
                                            <span class="desc">
                                                <%= c.description.length> 60 ?
                                                c.description.substring(0,60)+'...' :
                                                c.description %>
                                            </span>
                                        <% } else { %>
                                            <span class="muted">No description</span>
                                        <% } %>
                                    </td>
                                    <td class="muted">
                                        <%= c.memberCount || 0 %>
                                    </td>
                                    <td class="muted">
                                        <%= new Date(c.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
                                    </td>
                                    <td>
                                        <form method="post" action="/communities/<%= c.id %>/join">
                                            <div class="join-form">
                                                <select name="clientId" required>
                                                    <option value="">Your name</option>
                                                    <% clients.forEach(cl=> { %>
                                                        <option value="<%= cl.id %>">
                                                            <%= cl.username %>
                                                        </option>
                                                    <% }) %>
                                                </select>
                                                <button class="btn-join" type="submit">Join</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </section>
        </div>
    </main>
</body>

</html>